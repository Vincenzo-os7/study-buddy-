# BuddyStudy Environment Configuration

# Optional: Google Gemini API Key for dynamic AI Companion responses
# If left blank, BuddyStudy seamlessly falls back to high-fidelity, educational mock responses.
GEMINI_API_KEY=

# Supabase Credentials (optional for offline demo mode, required for remote cloud database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
