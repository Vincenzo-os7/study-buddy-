# BuddyStudy Environment Configuration

# Optional: Google Gemini API Key for dynamic AI Companion responses
# If left blank, BuddyStudy seamlessly falls back to high-fidelity, educational mock responses.
GEMINI_API_KEY=

# Optional: Next.js Port (Default 3000)
PORT=3000

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
